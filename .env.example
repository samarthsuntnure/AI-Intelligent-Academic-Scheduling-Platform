# Copy this file to .env (same folder) and fill in your local database
# connection. Both the API server and the Vite dev server read this file
# automatically -- no extra setup needed.
#
# This is a MySQL database. Manage it day-to-day with MySQL Workbench (or
# any other SQL client) -- this connection string is just what the Node
# app uses to talk to that same database.
#
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# - USER/PASSWORD: almost always "root" + the password you set when you
#   installed MySQL Server, unless you created a separate MySQL user.
# - PORT: 3306 is the MySQL default, but check what you actually used
#   during install -- some setups (e.g. if 3306 was already taken) use
#   3307/3308 instead. This MUST match your real MySQL Server's port.
DATABASE_URL=mysql://root:Samarth1234@127.0.0.1:3306/vidyaan

# A secret used to sign login sessions. Set this to a long random string
# for anything beyond local testing -- the default below is fine to leave
# as-is for local dev.
JWT_SECRET=vidyaan-dev-secret-change-me

# Port the Express API server listens on.
API_PORT=5000

# Port the Vite frontend dev server runs on.
WEB_PORT=5173

# Where the frontend dev server proxies /api requests to. Keep this in
# sync with API_PORT above.
API_PROXY_TARGET=http://localhost:5000
